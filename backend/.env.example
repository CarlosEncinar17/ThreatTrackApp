# ---------------------------------------------------------------------------
# ThreatTrackApp - backend. Copia este fichero a .env (desarrollo local) o define
# las variables en compose/.env (Docker). Nunca subas .env al repositorio.
# ---------------------------------------------------------------------------

# development | production
DJANGO_ENV=development

# Obligatorio en produccion: cadena aleatoria de >= 32 caracteres.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

DEBUG=True

# Hosts desde los que se acepta trafico (separados por comas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Origenes del frontend autorizados por CORS/CSRF (separados por comas)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Conexion a PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ThreatTrackAppDB

# True: la API exige usuario autenticado (analista o cliente).
# False: comportamiento heredado, acceso anonimo a toda la API (solo para demos).
API_REQUIRE_AUTH=True

# True solo cuando nginx/otro proxy termina TLS delante del backend
BEHIND_TLS_PROXY=False

# Limites de peticiones (formato DRF: numero/periodo)
THROTTLE_ANON=300/min
THROTTLE_USER=2000/min

LOG_LEVEL=INFO
TIME_ZONE=UTC

# Usuarios iniciales que crea `manage.py bootstrap_roles` al arrancar (opcionales).
# Si la contrasena esta vacia no se crea el usuario.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ANALYST_USERNAME=analyst
BOOTSTRAP_ANALYST_PASSWORD=
BOOTSTRAP_CLIENT_USERNAME=client
BOOTSTRAP_CLIENT_PASSWORD=
# Cliente (customers.name) al que pertenece el usuario BOOTSTRAP_CLIENT_USERNAME
BOOTSTRAP_CLIENT_CUSTOMER=TechSolutions

# ---------------------------------------------------------------------------
# Claves de las herramientas OSINT. Las leen los scripts de recoleccion (no
# forman parte de este repositorio); se mantienen aqui, fuera del codigo.
# ---------------------------------------------------------------------------
SHODAN_API_KEY=
INTELX_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TWITTER_BEARER_TOKEN=
