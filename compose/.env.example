# ---------------------------------------------------------------------------
# ThreatTrackApp - variables de Docker Compose. Copia este fichero a compose/.env
# y rellena los valores marcados. compose/.env nunca se sube al repositorio.
# ---------------------------------------------------------------------------

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=ThreatTrackAppDB
POSTGRES_USER=postgres
# Obligatorio. Ejemplo: openssl rand -base64 24
POSTGRES_PASSWORD=

# --- Backend (Django) ----------------------------------------------------------
# production (por defecto) | development
DJANGO_ENV=production
# Obligatorio: >= 32 caracteres. python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# True: exige inicio de sesion. False: API anonima (modo heredado, solo demos).
API_REQUIRE_AUTH=True
BEHIND_TLS_PROXY=False
THROTTLE_ANON=300/min
THROTTLE_USER=2000/min
LOG_LEVEL=INFO
TIME_ZONE=UTC
GUNICORN_WORKERS=3

# --- Usuarios iniciales (se crean solo si la contrasena no esta vacia) ---------
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ANALYST_USERNAME=analyst
BOOTSTRAP_ANALYST_PASSWORD=
BOOTSTRAP_CLIENT_USERNAME=client
BOOTSTRAP_CLIENT_PASSWORD=
BOOTSTRAP_CLIENT_CUSTOMER=TechSolutions

# --- Claves de herramientas OSINT (las usan los scripts de recoleccion) --------
SHODAN_API_KEY=
INTELX_API_KEY=
GITHUB_TOKEN=
GITLAB_TOKEN=
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TWITTER_BEARER_TOKEN=
